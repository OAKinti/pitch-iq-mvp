# ── Client (bundled into the app — PUBLIC values only) ─────────────────────
# Leave both Supabase values blank to run the zero-key Demo Mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Force Demo Mode even when keys are present: true | false
EXPO_PUBLIC_DEMO_MODE=true

# Public share identifiers (Day 6). Not secrets.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=

# ── NEVER put these in this file or in any EXPO_PUBLIC_* variable ─────────
# Server secrets live in Supabase edge-function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... ELEVENLABS_API_KEY=... \
#     ELEVENLABS_VOICE_CAPTAIN=... ELEVENLABS_VOICE_DRILL_SERGEANT=... ELEVENLABS_VOICE_HYPE=... \
#     ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# In Anthropic Cloud Routines, store them as environment network secrets (docs/CLOUD_ROUTINES_SETUP.md).
