{
  "name": "pitch-iq-mvp",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-media-library": "~58.0.14",
    "expo-mediapipe-pose": "0.5.2",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "check:compliance": "node scripts/check-compliance.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,tsx,json}\"",
    "verify": "npm run typecheck && npm test && npm run test:db && npm run lint:tokens && npm run check:compliance",
    "test:hooks": "node scripts/test-hooks.mjs",
    "doctor": "npx --yes expo-doctor@latest",
    "test:db": "node --test \"supabase/tests/db/*.test.mjs\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "src/services/**/*.ts",
      "!src/**/index.ts",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "./src/domain/": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/services/": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
